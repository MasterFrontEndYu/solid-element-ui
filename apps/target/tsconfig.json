{
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",
    // Modules
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    // Type Checking & Safety
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "solid-element-ui": [
        "../../packages/ui/src/index.tsx"
      ],
      "solid-element-ui/*": [
        "../../packages/ui/src/*"
      ]
    }
  }
}