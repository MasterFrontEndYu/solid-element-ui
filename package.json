{
    "name": "solid-box",
    "version": "0.0.0",
    "private": true,
    "workspaces": [
        "packages/*",
        "apps/*",
        "tools/*"
    ],
    "type": "module",
    "scripts": {
        "ready": "vp check && vp run -r test && vp run -r build",
        "dev": "vp run docs#dev",
        "prepare": "vp config"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.0",
        "@types/node": "^26.2.0",
        "solid-js": "^1.9.14",
        "typescript": "~7.0.2",
        "vite": "catalog:",
        "vite-plugin-console-pipe": "^2.1.0",
        "vite-plugin-dts": "^5.0.3",
        "vite-plus": "catalog:"
    },
    "overrides": {
        "vite": "catalog:"
    },
    "engines": {
        "node": ">=22.18.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.3.14",
            "onFail": "download"
        }
    },
    "catalog": {
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
        "vite-plus": "0.2.9"
    }
}
