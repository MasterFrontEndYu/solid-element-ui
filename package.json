{
    "name": "solid-box",
    "version": "0.0.0",
    "private": true,
    "workspaces": [
        "packages/*",
        "apps/*",
        "tools/*"
    ],
    "type": "module",
    "scripts": {
        "ready": "vp check && vp run -r test && vp run -r build",
        "dev": "vp run docs#dev",
        "prepare": "vp config",
        "test": "vp test"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.0",
        "@types/node": "^26.2.0",
        "solid-js": "^2.0.0-rc.0",
        "typescript": "~7.0.2",
        "vite": "catalog:",
        "vite-plugin-console-pipe": "^2.1.0",
        "vite-plugin-dts": "^5.0.3",
        "vite-plus": "catalog:",
        "vitest": "^4.1.10"
    },
    "overrides": {
        "vite": "catalog:"
    },
    "engines": {
        "node": ">=22.18.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.22.0",
            "onFail": "download"
        }
    }
}
