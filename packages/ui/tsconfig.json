{
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",
    // Modules
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    // Type Checking & Safety
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "rootDir": ".",
    "paths": {
      "solid-element-ui": [
        "./core/index.tsx"
      ]
    }
  },
  "include": [
    "core/**/*",
    "core/index.tsx",
    "globals.d.ts"
  ]
}